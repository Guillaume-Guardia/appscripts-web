{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"root": false,
	"extends": "//",
	"files": {
		"includes": ["**", "!**/vendor"]
	},
	"css": {
		"linter": {
			"enabled": true
		}
	},
	"overrides": [
		{
			"includes": ["**/*.css"],
			"linter": {
				"rules": {
					"style": {
						"noDescendingSpecificity": "off"
					}
				}
			}
		}
	]
}
